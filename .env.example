# =============================================================================
# PlayMind 环境变量示例
# -----------------------------------------------------------------------------
# 复制为 .env.local（本地开发）或填入 Vercel 项目环境变量。
# 未配置 DATABASE_URL 时服务自动降级为内存模式（房间随进程重启清空，适合本地开发）。
# 任何真实密钥都不要提交到仓库。
# =============================================================================

# Neon PostgreSQL 连接串（postgresql://user:pass@host/db?sslmode=require）。
# 留空则使用内存模式；生产环境必须配置。
DATABASE_URL=

# token / 会话 HMAC 密钥（任意高熵随机字符串，建议 32 字节以上）。
# 玩家 token、host token、管理员会话 token 的 sha 索引都依赖它，上线后不要更换。
TOKEN_SECRET=

# 初始管理员账号：系统中没有任何 admin_users 时，首次登录用这组凭据自动创建 root。
# 创建成功后即可修改密码/停用，环境变量不再参与登录校验。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 可选：公网访问地址（如 https://playmind.vercel.app）。
# 用于生成 joinUrl / playUrl / 邀请话术中的绝对链接；不配置时按请求 Host 推断。
PUBLIC_BASE_URL=

# 可选：Vercel Cron 调用 /api/cron/tick 的 Bearer 密钥。
# 配置后 Cron 请求需携带 Authorization: Bearer <CRON_SECRET>；留空则不做校验。
CRON_SECRET=
